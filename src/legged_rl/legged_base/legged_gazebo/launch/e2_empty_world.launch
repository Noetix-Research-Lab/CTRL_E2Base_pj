<launch>
  <arg name="robot_type" default="e2" doc="Robot type: [e2]"/>
  <arg name="robot_model" default="e2_23dof" doc="Robot model: [e2_23dof]"/>
  <arg name="urdfFile" default="$(find legged_e2_description)/urdf/e2_23dof.urdf"/>

  <param name="legged_robot_description" textfile="$(arg urdfFile)"/>
  <node name="generate_urdf" pkg="legged_common" type="generate_urdf.sh" output="screen"
        args="$(arg urdfFile) $(arg robot_type)"/>
  <rosparam file="$(find legged_gazebo)/config/default.yaml" command="load"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find legged_gazebo)/worlds/empty_world.world"/>
  </include>
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" clear_params="true"
        args="-z 0.82 -param legged_robot_description -urdf -model e2" output="screen"/>
</launch>
