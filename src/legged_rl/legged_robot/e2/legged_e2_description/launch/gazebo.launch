<launch>
  <arg name="model" default="$(find legged_e2_description)/urdf/e2_23dof.urdf"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch"/>
  <param name="legged_robot_description" textfile="$(arg model)"/>
  <node name="tf_footprint_base" pkg="tf" type="static_transform_publisher"
        args="0 0 0 0 0 0 base_link base_footprint 40"/>
  <node name="spawn_model" pkg="gazebo_ros" type="spawn_model"
        args="-z 0.82 -param legged_robot_description -urdf -model e2" output="screen"/>
  <node name="fake_joint_calibration" pkg="rostopic" type="rostopic"
        args="pub /calibrated std_msgs/Bool true"/>
</launch>
